# Example only. Load variables through your shell or hosting secret manager.
# This file is not automatically loaded. No real credentials are included.
APP_ENV=production
MODEL_PROVIDER=openai
MODEL_NAME=gpt-6-luna
MODEL_URL=https://api.openai.com/v1/chat/completions
MODEL_API_KEY=
ALLOWED_ORIGINS=https://YOUR-STATIC-SITE.onrender.com
BUDGET_DB=/var/data/usage.sqlite3
DAILY_BUDGET_USD=2
MONTHLY_BUDGET_USD=20
MODEL_TIMEOUT=45
RATE_LIMIT=10
GLOBAL_RATE_LIMIT=60
# Render ingress client-IP contract must be verified before trusting headers.
# Safe default: an honest site-wide rate cap, not a claimed per-visitor cap.
CLIENT_RATE_MODE=global
RATE_HASH_KEY=
TRUSTED_PROXY_CIDRS=
